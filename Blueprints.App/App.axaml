<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Blueprints.App"
             x:Class="Blueprints.App.App"
             RequestedThemeVariant="Light">
  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <Color x:Key="BlueprintInk">#101828</Color>
      <Color x:Key="BlueprintBlue">#6D5EF5</Color>
      <Color x:Key="BlueprintBright">#5A4AE8</Color>
      <Color x:Key="BlueprintCyan">#12B76A</Color>
      <Color x:Key="BlueprintPaper">#F7F8FA</Color>
      <Color x:Key="BlueprintLine">#E4E7EC</Color>
      <Color x:Key="BlueprintMuted">#667085</Color>

      <SolidColorBrush x:Key="InkBrush" Color="{StaticResource BlueprintInk}" />
      <SolidColorBrush x:Key="BlueBrush" Color="{StaticResource BlueprintBlue}" />
      <SolidColorBrush x:Key="BrightBrush" Color="{StaticResource BlueprintBright}" />
      <SolidColorBrush x:Key="PaperBrush" Color="{StaticResource BlueprintPaper}" />
      <SolidColorBrush x:Key="LineBrush" Color="{StaticResource BlueprintLine}" />
      <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource BlueprintMuted}" />

      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="#F2F4F7" />
          <SolidColorBrush x:Key="CanvasToolbarBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="CanvasInspectorBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="CanvasInspectorHeaderBrush" Color="#F9FAFB" />
          <SolidColorBrush x:Key="CanvasOverlayBrush" Color="#F5FFFFFF" />
          <SolidColorBrush x:Key="CanvasControlBackgroundBrush" Color="#F2F4F7" />
          <SolidColorBrush x:Key="CanvasFrameBackgroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="CanvasFrameHeaderBrush" Color="#F9FAFB" />
          <SolidColorBrush x:Key="CanvasFrameBorderBrush" Color="#D0D5DD" />
          <SolidColorBrush x:Key="CanvasColumnBackgroundBrush" Color="#F2F4F7" />
          <SolidColorBrush x:Key="CanvasColumnBorderBrush" Color="#E4E7EC" />
          <SolidColorBrush x:Key="CanvasCardBackgroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="CanvasCardBorderBrush" Color="#D0D5DD" />
          <SolidColorBrush x:Key="CanvasAccentBrush" Color="#6D5EF5" />
          <SolidColorBrush x:Key="CanvasSelectionBrush" Color="#6D5EF5" />
          <SolidColorBrush x:Key="CanvasSelectionFillBrush" Color="#206D5EF5" />
          <SolidColorBrush x:Key="CanvasWarningBrush" Color="#B54708" />
          <SolidColorBrush x:Key="CanvasMutedBrush" Color="#667085" />
          <SolidColorBrush x:Key="CanvasResizeBrush" Color="#98A2B3" />
          <SolidColorBrush x:Key="CanvasStatusBarBrush" Color="#101828" />
          <SolidColorBrush x:Key="CanvasMinimapBackgroundBrush" Color="#EAECF0" />
          <SolidColorBrush x:Key="CanvasMinimapSelectionBrush" Color="#6D5EF5" />
          <SolidColorBrush x:Key="CanvasMinimapFrameBrush" Color="#667085" />
          <SolidColorBrush x:Key="CanvasMinimapNodeBrush" Color="#12B76A" />
          <SolidColorBrush x:Key="CanvasViewportFillBrush" Color="#186D5EF5" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="#111827" />
          <SolidColorBrush x:Key="CanvasToolbarBrush" Color="#182230" />
          <SolidColorBrush x:Key="CanvasInspectorBrush" Color="#182230" />
          <SolidColorBrush x:Key="CanvasInspectorHeaderBrush" Color="#1D2939" />
          <SolidColorBrush x:Key="CanvasOverlayBrush" Color="#F51D2939" />
          <SolidColorBrush x:Key="CanvasControlBackgroundBrush" Color="#344054" />
          <SolidColorBrush x:Key="CanvasFrameBackgroundBrush" Color="#1D2939" />
          <SolidColorBrush x:Key="CanvasFrameHeaderBrush" Color="#344054" />
          <SolidColorBrush x:Key="CanvasFrameBorderBrush" Color="#475467" />
          <SolidColorBrush x:Key="CanvasColumnBackgroundBrush" Color="#182230" />
          <SolidColorBrush x:Key="CanvasColumnBorderBrush" Color="#344054" />
          <SolidColorBrush x:Key="CanvasCardBackgroundBrush" Color="#344054" />
          <SolidColorBrush x:Key="CanvasCardBorderBrush" Color="#475467" />
          <SolidColorBrush x:Key="CanvasAccentBrush" Color="#9B8AFB" />
          <SolidColorBrush x:Key="CanvasSelectionBrush" Color="#9B8AFB" />
          <SolidColorBrush x:Key="CanvasSelectionFillBrush" Color="#229B8AFB" />
          <SolidColorBrush x:Key="CanvasWarningBrush" Color="#FDA29B" />
          <SolidColorBrush x:Key="CanvasMutedBrush" Color="#D0D5DD" />
          <SolidColorBrush x:Key="CanvasResizeBrush" Color="#98A2B3" />
          <SolidColorBrush x:Key="CanvasStatusBarBrush" Color="#0C111D" />
          <SolidColorBrush x:Key="CanvasMinimapBackgroundBrush" Color="#0C111D" />
          <SolidColorBrush x:Key="CanvasMinimapSelectionBrush" Color="#BDB4FE" />
          <SolidColorBrush x:Key="CanvasMinimapFrameBrush" Color="#7F8FA6" />
          <SolidColorBrush x:Key="CanvasMinimapNodeBrush" Color="#6CE9A6" />
          <SolidColorBrush x:Key="CanvasViewportFillBrush" Color="#229B8AFB" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="TextBlock">
      <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter#Inter" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Cascadia Mono, SFMono-Regular, Consolas, monospace" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#5A4AE8" />
      <Setter Property="LetterSpacing" Value="1" />
    </Style>
    <Style Selector="TextBlock.page-title">
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="-0.5" />
    </Style>
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.field-label">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#475467" />
    </Style>

    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#D0D5DD" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="SelectionBrush" Value="#D9D6FE" />
    </Style>
    <Style Selector="TextBox:pointerover">
      <Setter Property="BorderBrush" Value="#98A2B3" />
    </Style>
    <Style Selector="TextBox:focus">
      <Setter Property="BorderBrush" Value="#6D5EF5" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#D0D5DD" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="MinHeight" Value="32" />
    </Style>

    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="15,9" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#6D5EF5" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#6D5EF5" />
    </Style>
    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="#5A4AE8" />
      <Setter Property="BorderBrush" Value="#5A4AE8" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="#344054" />
      <Setter Property="BorderBrush" Value="#D0D5DD" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.secondary:pointerover">
      <Setter Property="Background" Value="#F9FAFB" />
      <Setter Property="BorderBrush" Value="#98A2B3" />
    </Style>
    <Style Selector="Button.quiet">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Foreground" Value="#344054" />
    </Style>
    <Style Selector="Button.quiet:pointerover">
      <Setter Property="Background" Value="#F2F4F7" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="#B42318" />
      <Setter Property="BorderBrush" Value="#FDA29B" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.danger-solid">
      <Setter Property="Background" Value="#D92D20" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#D92D20" />
    </Style>
    <Style Selector="Button.compact">
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.app-tab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#A9B7CD" />
      <Setter Property="BorderThickness" Value="0,0,0,3" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="13,4,13,1" />
      <Setter Property="MinHeight" Value="72" />
    </Style>
    <Style Selector="Button.app-tab:pointerover">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Background" Value="#182230" />
    </Style>
    <Style Selector="Button.app-tab.active">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#9B8AFB" />
    </Style>
    <Style Selector="Button.user-menu">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="5" />
    </Style>
    <Style Selector="Button.user-menu:pointerover">
      <Setter Property="Background" Value="#1D2939" />
    </Style>
    <Style Selector="Button.tool">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="#344054" />
      <Setter Property="BorderBrush" Value="#D0D5DD" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.tool:pointerover">
      <Setter Property="Background" Value="#F9FAFB" />
      <Setter Property="BorderBrush" Value="#98A2B3" />
    </Style>
    <Style Selector="Button.tool.active">
      <Setter Property="Background" Value="#F0EEFF" />
      <Setter Property="Foreground" Value="#5A4AE8" />
      <Setter Property="BorderBrush" Value="#BDB4FE" />
    </Style>
    <Style Selector="Button.tool.square">
      <Setter Property="Width" Value="34" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.view-tab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#667085" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.view-tab.active">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="#5A4AE8" />
      <Setter Property="BorderBrush" Value="#D0D5DD" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.item-row">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#E4E7EC" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#E4E7EC" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="20" />
    </Style>
    <Style Selector="Border.subtle-card">
      <Setter Property="Background" Value="#F9FAFB" />
      <Setter Property="BorderBrush" Value="#E4E7EC" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14" />
    </Style>
    <Style Selector="Border.blueprint-card">
      <Setter Property="Background" Value="#F9FAFB" />
      <Setter Property="BorderBrush" Value="#E4E7EC" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14" />
    </Style>
    <Style Selector="Border.dark-card">
      <Setter Property="Background" Value="#182230" />
      <Setter Property="BorderBrush" Value="#344054" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="20" />
    </Style>
    <Style Selector="Border.callout">
      <Setter Property="Background" Value="#F0EEFF" />
      <Setter Property="BorderBrush" Value="#D9D6FE" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14" />
    </Style>
    <Style Selector="Border.status-pill">
      <Setter Property="Background" Value="#F2F4F7" />
      <Setter Property="BorderBrush" Value="#E4E7EC" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="9,4" />
    </Style>
    <Style Selector="Border.success">
      <Setter Property="Background" Value="#ECFDF3" />
      <Setter Property="BorderBrush" Value="#ABEFC6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="Border.project-context">
      <Setter Property="Background" Value="#182230" />
      <Setter Property="BorderBrush" Value="#344054" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="Border.header-status">
      <Setter Property="Background" Value="#182230" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="10,7" />
    </Style>
    <Style Selector="Border.modal-card">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#D0D5DD" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="24" />
      <Setter Property="BoxShadow" Value="0 24 64 0 #40101828" />
    </Style>
    <Style Selector="Border.view-switcher">
      <Setter Property="Background" Value="#F2F4F7" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="3" />
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="ListBoxItem:selected">
      <Setter Property="Background" Value="#F0EEFF" />
    </Style>
    <Style Selector="TabControl.inspector-tabs TabItem">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="MinHeight" Value="38" />
    </Style>
  </Application.Styles>
</Application>
