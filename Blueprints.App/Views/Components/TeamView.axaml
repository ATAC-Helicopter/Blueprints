<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Blueprints.App.ViewModels"
             xmlns:models="using:Blueprints.App.Models"
             x:Class="Blueprints.App.Views.Components.TeamView"
             x:DataType="vm:MainWindowViewModel">
  <Grid RowDefinitions="104,*" Background="#F7F8FA">
    <Border Background="#FFFFFF" BorderBrush="#E4E7EC" BorderThickness="0,0,0,1" Padding="28,18">
      <StackPanel Spacing="4" VerticalAlignment="Center">
        <TextBlock Text="Team" Classes="page-title" />
        <TextBlock Text="Manage project access, invitations, and your local signing identity." Classes="muted" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="340,*" ColumnSpacing="18" Margin="24,20">
      <ScrollViewer>
        <StackPanel Spacing="14">
          <Border Classes="dark-card">
            <StackPanel Spacing="10">
              <TextBlock Text="YOUR IDENTITY" Classes="eyebrow" Foreground="#BDB4FE" />
              <TextBlock Text="{Binding Identity.DisplayName}" FontSize="21" FontWeight="SemiBold" Foreground="White" />
              <TextBlock Text="{Binding Identity.UserId}" Classes="mono" FontSize="10" Foreground="#A9B7CD" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Identity.KeyStorageProvider, StringFormat='Protected by {0}'}"
                         Foreground="#D0D5DD" FontSize="11" />
              <Button Classes="secondary" Content="Export identity invitation…"
                      Click="ExportIdentityInvitation_Click" HorizontalAlignment="Left" />
              <Border Height="1" Background="#344054" Margin="0,4" />
              <TextBlock Text="Encrypted recovery backup" Foreground="White" FontWeight="SemiBold" />
              <TextBox Text="{Binding IdentityBackupPassphrase}" PlaceholderText="Passphrase (12+ characters)" PasswordChar="●" />
              <Button Classes="primary" Content="Create backup…" Click="ExportIdentityBackup_Click" HorizontalAlignment="Left" />
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel Spacing="10">
              <TextBlock Text="ADD MEMBER" Classes="eyebrow" />
              <Button Classes="secondary" Content="Import identity invitation…" Click="ImportIdentityInvitation_Click"
                      IsEnabled="{Binding CanManageMembers}" HorizontalAlignment="Left" />
              <TextBox Text="{Binding InviteUserId}" PlaceholderText="User ID" IsReadOnly="True" />
              <TextBox Text="{Binding InviteDisplayName}" PlaceholderText="Display name" />
              <ComboBox ItemsSource="{Binding AvailableMemberRoles}" SelectedItem="{Binding InviteRole}" />
              <TextBox Text="{Binding InvitePublicKey}" PlaceholderText="Public key" AcceptsReturn="True" Height="76"
                       IsReadOnly="True" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="10" />
              <Button Classes="primary" Content="Add member" Command="{Binding InviteMemberCommand}"
                      IsEnabled="{Binding CanManageMembers}" HorizontalAlignment="Left" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <Grid Grid.Column="1" RowDefinitions="*,Auto" RowSpacing="14">
        <Border Classes="card">
          <Grid RowDefinitions="Auto,*" RowSpacing="12">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="3">
                <TextBlock Text="PROJECT MEMBERS" Classes="eyebrow" />
                <TextBlock Text="People and permissions" FontSize="20" FontWeight="SemiBold" />
              </StackPanel>
              <Border Grid.Column="1" Classes="status-pill" VerticalAlignment="Center">
                <TextBlock Text="{Binding MembershipRevision, StringFormat='Revision {0}'}" Classes="mono" FontSize="10" />
              </Border>
            </Grid>
            <ListBox Grid.Row="1" ItemsSource="{Binding Members}" SelectedItem="{Binding SelectedMember}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:WorkspaceMemberCard">
                  <Grid Margin="8,10" ColumnDefinitions="42,*,120,90" ColumnSpacing="12">
                    <Border Width="34" Height="34" CornerRadius="17" Background="#F0EEFF">
                      <TextBlock Text="ID" Foreground="#5A4AE8" FontSize="9" FontWeight="Bold"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2">
                      <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding UserId}" Classes="mono muted" FontSize="9" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Role}" Foreground="#5A4AE8" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding IsActive, StringFormat='Active: {0}'}" Classes="muted" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>

        <Border Grid.Row="1" Classes="card">
          <Grid ColumnDefinitions="*,200,170,Auto,Auto" ColumnSpacing="10">
            <StackPanel Spacing="3">
              <TextBlock Text="SELECTED MEMBER" Classes="eyebrow" />
              <TextBlock Text="{Binding SelectedMemberStateSummary}" Classes="muted" FontSize="10" TextWrapping="Wrap" />
            </StackPanel>
            <TextBox Grid.Column="1" Text="{Binding MemberEditorDisplayName}" PlaceholderText="Display name"
                     IsEnabled="{Binding CanEditSelectedMember}" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
              <ComboBox Width="110" ItemsSource="{Binding AvailableMemberRoles}" SelectedItem="{Binding MemberEditorRole}"
                        IsEnabled="{Binding CanEditSelectedMember}" />
              <CheckBox Content="Active" IsChecked="{Binding MemberEditorIsActive}" IsEnabled="{Binding CanEditSelectedMember}" />
            </StackPanel>
            <Button Grid.Column="3" Classes="primary" Content="Save" Command="{Binding SaveMemberDetailsCommand}"
                    IsEnabled="{Binding CanEditSelectedMember}" />
            <Button Grid.Column="4" Classes="secondary" Content="Export project invite…" Click="ExportProjectInvitation_Click"
                    IsEnabled="{Binding CanManageMembers}" />
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
