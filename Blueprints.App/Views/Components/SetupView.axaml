<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Blueprints.App.ViewModels"
             xmlns:models="using:Blueprints.App.Models"
             x:Class="Blueprints.App.Views.Components.SetupView"
             x:DataType="vm:MainWindowViewModel">
  <Grid RowDefinitions="72,*" Background="#F7F8FA">
    <Border Background="#101828" Padding="28,0">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
          <Border Width="36" Height="36" CornerRadius="9" Background="#6D5EF5">
            <TextBlock Text="B" Foreground="White" FontSize="17" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Spacing="0" VerticalAlignment="Center">
            <TextBlock Text="Blueprints" Foreground="White" FontSize="17" FontWeight="Bold" />
            <TextBlock Text="Local-first release planning" Foreground="#A9B7CD" FontSize="10" />
          </StackPanel>
        </StackPanel>
        <Border Grid.Column="1" Background="#182230" CornerRadius="9" Padding="12,8" VerticalAlignment="Center">
          <TextBlock Text="No hosted account required" Foreground="#D0D5DD" FontSize="11" />
        </Border>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1">
      <Grid ColumnDefinitions="320,*" ColumnSpacing="24" Margin="32,28" MaxWidth="1320" HorizontalAlignment="Center">
        <StackPanel Spacing="16">
          <StackPanel Spacing="5">
            <TextBlock Text="Your projects" Classes="page-title" />
            <TextBlock Text="Open a recent workspace or start with a new one."
                       Classes="muted" TextWrapping="Wrap" />
          </StackPanel>

          <Border Classes="card" Padding="12">
            <Grid RowDefinitions="*,Auto" RowSpacing="12">
              <ListBox ItemsSource="{Binding RecentProjects}"
                       SelectedItem="{Binding SelectedRecentProject}"
                       MinHeight="240" MaxHeight="520">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="models:RecentProjectReference">
                    <Grid Margin="4,8" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <StackPanel Spacing="3">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="{Binding LocalWorkspaceRoot}" Classes="mono muted" FontSize="9"
                                   MaxWidth="230" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding LastOpenedUtc, StringFormat='Opened {0:g}'}"
                                   Classes="muted" FontSize="9" />
                      </StackPanel>
                      <Border Grid.Column="1" Background="#F0EEFF" CornerRadius="7" Padding="7,3" VerticalAlignment="Top">
                        <TextBlock Text="{Binding ProjectCode}" Foreground="#5A4AE8" Classes="mono" FontSize="9" FontWeight="Bold" />
                      </Border>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Button Classes="primary" Content="Open selected"
                        Command="{Binding OpenSelectedRecentProjectCommand}" />
                <Button Grid.Column="1" Classes="danger" Content="Delete…"
                        Command="{Binding BeginDeleteSelectedProjectCommand}" />
              </Grid>
            </Grid>
          </Border>

          <Border Classes="subtle-card">
            <StackPanel Spacing="5">
              <TextBlock Text="What Blueprints stores" FontWeight="SemiBold" />
              <TextBlock Text="Your editable workspace, a separate shared exchange, and a device-local signing identity. Repositories remain independent."
                         Classes="muted" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="1" Spacing="16">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
            <StackPanel Spacing="5">
              <TextBlock Text="Set up Blueprints" Classes="page-title" />
              <TextBlock Text="Create your identity once, then choose how you want to open a workspace."
                         Classes="muted" />
            </StackPanel>
            <Border Grid.Column="1" Classes="success" IsVisible="{Binding HasSetupMessage}" MaxWidth="360">
              <TextBlock Text="{Binding SetupMessage}" Foreground="#067647" FontSize="11" TextWrapping="Wrap" />
            </Border>
          </Grid>

          <Border Classes="card">
            <Grid ColumnDefinitions="48,*,250,Auto" ColumnSpacing="14">
              <Border Width="44" Height="44" CornerRadius="12" Background="#F0EEFF" VerticalAlignment="Center">
                <TextBlock Text="1" Foreground="#5A4AE8" FontWeight="Bold" FontSize="15"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="Signing identity" FontWeight="SemiBold" FontSize="15" />
                <TextBlock Text="{Binding LocalIdentitySetupSummary}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
              <Grid Grid.Column="2">
                <TextBox Text="{Binding IdentitySetupName}" PlaceholderText="Display name"
                         IsVisible="{Binding IsIdentitySetupRequired}" />
                <TextBox Text="{Binding IdentityBackupPassphrase}" PlaceholderText="Backup passphrase"
                         PasswordChar="●" IsVisible="{Binding HasLocalIdentity}" />
              </Grid>
              <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                <Button Classes="primary" Content="Create identity"
                        Command="{Binding CreateLocalIdentityCommand}" IsVisible="{Binding IsIdentitySetupRequired}" />
                <Button Classes="secondary" Content="Back up…" Click="ExportIdentityBackup_Click"
                        IsVisible="{Binding HasLocalIdentity}" />
                <Button Classes="secondary" Content="Restore…" Click="ImportIdentityBackup_Click"
                        IsVisible="{Binding IsIdentitySetupRequired}" />
              </StackPanel>
            </Grid>
          </Border>

          <TabControl>
            <TabItem Header="Create project">
              <Border Classes="card" Margin="0,12,0,0">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
                  <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                      <TextBlock Text="Create a new workspace" Classes="section-title" />
                      <TextBlock Text="Name the project and choose how releases are identified."
                                 Classes="muted" TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,150" ColumnSpacing="10">
                      <StackPanel Spacing="5">
                        <TextBlock Text="Project name" Classes="field-label" />
                        <TextBox Text="{Binding CreateProjectName}" PlaceholderText="Mobile application" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="5">
                        <TextBlock Text="Project code" Classes="field-label" />
                        <TextBox Text="{Binding CreateProjectCode}" PlaceholderText="APP" />
                      </StackPanel>
                    </Grid>
                    <StackPanel Spacing="5">
                      <TextBlock Text="Release naming" Classes="field-label" />
                      <TextBox Text="{Binding CreateVersioningScheme}" PlaceholderText="SemVer" />
                    </StackPanel>
                    <Button Classes="primary" Content="Create and open project"
                            Command="{Binding CreateProjectCommand}" IsEnabled="{Binding HasLocalIdentity}"
                            HorizontalAlignment="Left" />
                  </StackPanel>

                  <StackPanel Grid.Column="1" Spacing="14">
                    <StackPanel Spacing="5">
                      <TextBlock Text="Local workspace" Classes="field-label" />
                      <TextBlock Text="The editable copy on this computer." Classes="muted" FontSize="10" />
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Text="{Binding CreateLocalWorkspaceRoot}" />
                        <Button Grid.Column="1" Classes="secondary" Content="Choose…" Click="BrowseCreateLocal_Click" />
                      </Grid>
                    </StackPanel>
                    <StackPanel Spacing="5">
                      <TextBlock Text="Shared exchange" Classes="field-label" />
                      <TextBlock Text="A separate folder used only for signed team changes." Classes="muted" FontSize="10" />
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Text="{Binding CreateSharedWorkspaceRoot}" />
                        <Button Grid.Column="1" Classes="secondary" Content="Choose…" Click="BrowseCreateShared_Click" />
                      </Grid>
                    </StackPanel>
                    <Border Classes="callout">
                      <TextBlock Text="The two folders must be separate and neither can contain the other."
                                 Foreground="#5A4AE8" FontSize="11" TextWrapping="Wrap" />
                    </Border>
                  </StackPanel>
                </Grid>
              </Border>
            </TabItem>

            <TabItem Header="Open project">
              <Border Classes="card" Margin="0,12,0,0">
                <StackPanel Spacing="16">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Open an existing workspace" Classes="section-title" />
                    <TextBlock Text="Choose the local editable copy and its matching shared exchange. Blueprints validates both before opening."
                               Classes="muted" TextWrapping="Wrap" />
                  </StackPanel>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                    <StackPanel Spacing="5">
                      <TextBlock Text="Local workspace" Classes="field-label" />
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Text="{Binding OpenLocalWorkspaceRoot}" />
                        <Button Grid.Column="1" Classes="secondary" Content="Choose…" Click="BrowseOpenLocal_Click" />
                      </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="5">
                      <TextBlock Text="Shared exchange" Classes="field-label" />
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Text="{Binding OpenSharedWorkspaceRoot}" />
                        <Button Grid.Column="1" Classes="secondary" Content="Choose…" Click="BrowseOpenShared_Click" />
                      </Grid>
                    </StackPanel>
                  </Grid>
                  <Button Classes="primary" Content="Validate and open"
                          Command="{Binding OpenProjectCommand}" IsEnabled="{Binding HasLocalIdentity}"
                          HorizontalAlignment="Left" />
                </StackPanel>
              </Border>
            </TabItem>

            <TabItem Header="Join team">
              <Border Classes="card" Margin="0,12,0,0">
                <StackPanel Spacing="16">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Join with a project invitation" Classes="section-title" />
                    <TextBlock Text="Use the invitation created specifically for your signing identity."
                               Classes="muted" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Spacing="5">
                    <TextBlock Text="Project invitation" Classes="field-label" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBox Text="{Binding JoinInvitationFilePath}" />
                      <Button Grid.Column="1" Classes="secondary" Content="Choose…" Click="BrowseJoinInvitation_Click" />
                    </Grid>
                  </StackPanel>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                    <StackPanel Spacing="5">
                      <TextBlock Text="New local workspace" Classes="field-label" />
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Text="{Binding JoinLocalWorkspaceRoot}" />
                        <Button Grid.Column="1" Classes="secondary" Content="Choose…" Click="BrowseJoinLocal_Click" />
                      </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="5">
                      <TextBlock Text="Shared exchange" Classes="field-label" />
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Text="{Binding JoinSharedWorkspaceRoot}" />
                        <Button Grid.Column="1" Classes="secondary" Content="Choose…" Click="BrowseJoinShared_Click" />
                      </Grid>
                    </StackPanel>
                  </Grid>
                  <Button Classes="primary" Content="Validate invitation and join"
                          Command="{Binding JoinProjectCommand}" IsEnabled="{Binding HasLocalIdentity}"
                          HorizontalAlignment="Left" />
                </StackPanel>
              </Border>
            </TabItem>
          </TabControl>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>
