<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Blueprints.App.ViewModels"
             xmlns:models="using:Blueprints.App.Models"
             x:Class="Blueprints.App.Views.Components.ReleasePlannerView"
             x:DataType="vm:MainWindowViewModel">
  <Grid RowDefinitions="104,*" Background="#F7F8FA">
    <Border Background="#FFFFFF" BorderBrush="#E4E7EC" BorderThickness="0,0,0,1" Padding="28,18">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
        <StackPanel Spacing="4" VerticalAlignment="Center">
          <TextBlock Text="Releases" Classes="page-title" />
          <TextBlock Text="Define scope, check readiness, and publish release notes from one place." Classes="muted" />
        </StackPanel>
        <Grid Grid.Column="1" ColumnDefinitions="220,Auto" ColumnSpacing="8" VerticalAlignment="Center">
          <TextBox Text="{Binding NewVersionName}" PlaceholderText="New release name" />
          <Button Grid.Column="1" Classes="primary" Content="Create release" Command="{Binding CreateVersionCommand}"
                  IsEnabled="{Binding CanMutateWorkspace}" />
        </Grid>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="300,*" ColumnSpacing="20" Margin="24,20">
      <Border Classes="card" Padding="12">
        <Grid RowDefinitions="Auto,*" RowSpacing="10">
          <StackPanel Margin="8,4" Spacing="3">
            <TextBlock Text="RELEASE LIST" Classes="eyebrow" />
            <TextBlock Text="Select a release to manage" FontWeight="SemiBold" />
          </StackPanel>
          <Grid Grid.Row="1">
            <ListBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:WorkspaceVersionCard">
                  <Grid Margin="5,9" RowDefinitions="Auto,Auto,Auto" RowSpacing="5">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
                      <Border Grid.Column="1" Classes="status-pill">
                        <TextBlock Text="{Binding Status}" FontSize="9" FontWeight="SemiBold" />
                      </Border>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding Notes}" Classes="muted" FontSize="10"
                               MaxHeight="32" TextWrapping="Wrap" />
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding CompletedItemCount, StringFormat='Completed {0}'}" Foreground="#067647" FontSize="10" />
                      <TextBlock Grid.Column="1" Text="{Binding ItemCount, StringFormat='Total {0}'}" Classes="muted" FontSize="10" />
                    </Grid>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="No releases yet" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding IsProjectVersionEmpty}" />
          </Grid>
        </Grid>
      </Border>

      <ScrollViewer Grid.Column="1">
        <StackPanel Spacing="16">
          <Border Classes="card">
            <StackPanel Spacing="16">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                <StackPanel Spacing="3">
                  <TextBlock Text="SELECTED RELEASE" Classes="eyebrow" />
                  <TextBlock Text="{Binding SelectedVersionStateSummary}" Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <Button Classes="secondary" Content="Preview notes" Command="{Binding PreviewSelectedVersionChangelogCommand}" />
                  <Button Classes="primary" Content="Export notes" Command="{Binding ExportSelectedVersionChangelogCommand}" />
                  <Button Classes="danger" Content="Archive…" Command="{Binding ArchiveSelectedVersionCommand}"
                          IsEnabled="{Binding CanArchiveSelectedVersion}" />
                  <Button Classes="danger-solid" Content="Mark released" Command="{Binding ReleaseSelectedVersionCommand}"
                          IsEnabled="{Binding CanReleaseSelectedVersion}" />
                </StackPanel>
              </Grid>

              <Grid ColumnDefinitions="1.1*,0.9*" ColumnSpacing="18">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,170" ColumnSpacing="10">
                    <StackPanel Spacing="5">
                      <TextBlock Text="Release name" Classes="field-label" />
                      <TextBox Text="{Binding VersionEditorName}" IsEnabled="{Binding CanEditSelectedVersion}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="5">
                      <TextBlock Text="State" Classes="field-label" />
                      <ComboBox ItemsSource="{Binding AvailableStatuses}" SelectedItem="{Binding VersionEditorStatus}"
                                IsEnabled="{Binding CanEditSelectedVersion}" />
                    </StackPanel>
                  </Grid>
                  <StackPanel Spacing="5">
                    <TextBlock Text="Outcome and context" Classes="field-label" />
                    <TextBox Text="{Binding VersionEditorNotes}" AcceptsReturn="True" Height="86"
                             IsEnabled="{Binding CanEditSelectedVersion}" />
                  </StackPanel>
                  <Button Classes="secondary" Content="Save release details" Command="{Binding SaveVersionDetailsCommand}"
                          IsEnabled="{Binding CanEditSelectedVersion}" HorizontalAlignment="Left" />
                </StackPanel>

                <Border Grid.Column="1" Classes="subtle-card">
                  <StackPanel Spacing="8">
                    <TextBlock Text="RELEASE NOTES" Classes="eyebrow" />
                    <WrapPanel>
                      <CheckBox Content="Incomplete" IsChecked="{Binding ChangelogIncludeIncomplete}" Margin="0,0,10,0" />
                      <CheckBox Content="Keys" IsChecked="{Binding ChangelogIncludeItemKeys}" Margin="0,0,10,0" />
                      <CheckBox Content="Descriptions" IsChecked="{Binding ChangelogIncludeDescriptions}" Margin="0,0,10,0" />
                      <CheckBox Content="Compact" IsChecked="{Binding ChangelogCompactMode}" />
                    </WrapPanel>
                    <TextBox Text="{Binding ChangelogPreview}" AcceptsReturn="True" IsReadOnly="True"
                             MinHeight="145" TextWrapping="Wrap" Classes="mono" FontSize="11" />
                    <TextBlock Text="{Binding LastChangelogExportPath}" Classes="mono muted" FontSize="10" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>
          </Border>

          <Border Classes="card">
            <Grid ColumnDefinitions="0.9*,1.1*" ColumnSpacing="20">
              <StackPanel Spacing="10">
                <TextBlock Text="RELEASE READINESS" Classes="eyebrow" />
                <TextBlock Text="{Binding ReleaseReadinessSummary}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding GitChangelogSummary}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                <Button Classes="secondary" Content="Open Imports" Command="{Binding NavigateToIntegrationsCommand}"
                        HorizontalAlignment="Left" />
              </StackPanel>
              <ItemsControl Grid.Column="1" ItemsSource="{Binding ReleaseReadinessDiagnostics}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:ReleaseReadinessDiagnostic">
                    <Border Classes="subtle-card" Margin="0,0,0,7">
                      <Grid ColumnDefinitions="90,*,1.1*" ColumnSpacing="10">
                        <TextBlock Text="{Binding Level}" Classes="eyebrow" />
                        <StackPanel Grid.Column="1" Spacing="2">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="10" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding Guidance}" Foreground="#5A4AE8" FontSize="10" TextWrapping="Wrap" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </Border>

          <Border Classes="card">
            <Grid ColumnDefinitions="330,*" ColumnSpacing="20">
              <StackPanel Spacing="10">
                <TextBlock Text="WORK ITEM" Classes="eyebrow" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                  <ComboBox ItemsSource="{Binding AvailableItemTypes}" SelectedItem="{Binding SelectedItemTypeId}" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableCategories}" SelectedItem="{Binding SelectedCategoryId}" />
                </Grid>
                <TextBox Text="{Binding ItemEditorTitle}" PlaceholderText="Concise outcome" />
                <TextBox Text="{Binding ItemEditorDescription}" PlaceholderText="Useful context" AcceptsReturn="True" Height="80" />
                <CheckBox Content="Completed and ready for release notes" IsChecked="{Binding ItemEditorIsDone}" />
                <WrapPanel>
                  <Button Classes="primary" Content="Add item" Command="{Binding AddItemCommand}" Margin="0,0,8,8" />
                  <Button Classes="secondary" Content="Save selected" Command="{Binding SaveItemDetailsCommand}" Margin="0,0,8,8" />
                  <Button Classes="danger" Content="Archive item…" Command="{Binding ArchiveSelectedItemCommand}"
                          IsEnabled="{Binding CanArchiveSelectedItem}" Margin="0,0,8,8" />
                </WrapPanel>
              </StackPanel>

              <StackPanel Grid.Column="1" Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Text="ITEMS IN THIS RELEASE" Classes="eyebrow" />
                    <TextBlock Text="Select an item to edit it" Classes="muted" FontSize="11" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding SelectedVersion.ItemCount, StringFormat='Items {0}'}"
                             Classes="muted" VerticalAlignment="Center" />
                </Grid>
                <ScrollViewer MinHeight="230">
                  <ItemsControl ItemsSource="{Binding SelectedVersion.ItemGroups}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:WorkspaceItemCategoryGroup">
                        <StackPanel Spacing="6" Margin="0,0,0,12">
                          <TextBlock Text="{Binding CategoryId}" Classes="eyebrow" />
                          <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="models:WorkspaceItemCard">
                                <Button Classes="item-row" Click="SelectReleaseItem_Click" HorizontalContentAlignment="Stretch" Margin="0,0,0,6">
                                  <Grid ColumnDefinitions="88,*,Auto" ColumnSpacing="10">
                                    <TextBlock Text="{Binding ItemKey}" Classes="mono" Foreground="#5A4AE8" FontWeight="SemiBold" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                      <TextBlock Text="{Binding Description}" Classes="muted" FontSize="10" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Classes="status-pill">
                                      <TextBlock Text="{Binding ItemTypeId}" FontSize="9" />
                                    </Border>
                                  </Grid>
                                </Button>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
