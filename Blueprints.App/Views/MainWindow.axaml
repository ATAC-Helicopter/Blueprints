<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Blueprints.App.ViewModels"
        xmlns:views="using:Blueprints.App.Views.Components"
        xmlns:automation="using:Avalonia.Automation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1440"
        d:DesignHeight="920"
        x:Class="Blueprints.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Blueprints"
        Icon="/Assets/blueprints.ico"
        Width="1440"
        Height="920"
        MinWidth="1000"
        MinHeight="680"
        Background="#F4F1EA">
  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>

  <Grid>
    <views:SetupView IsVisible="{Binding IsSetupMode}" />

    <Grid ColumnDefinitions="232,*" IsVisible="{Binding HasActiveSession}">
      <!-- The app is a planning desk: the plan stays central and project utilities stay quiet. -->
      <Border Background="#FBFAF6"
              BorderBrush="#DDD8CC"
              BorderThickness="0,0,1,0"
              Padding="14,18,14,14">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="22">
          <Button Classes="project-switcher"
                  Command="{Binding NavigateToOverviewCommand}"
                  ToolTip.Tip="Return to the plan">
            <Grid ColumnDefinitions="38,*" ColumnSpacing="10">
              <Border Width="38" Height="38" CornerRadius="12" Background="#E85D3F">
                <TextBlock Text="B" Foreground="White" FontSize="18" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                <TextBlock Text="BLUEPRINTS" FontSize="10" FontWeight="Bold" LetterSpacing="1.5" Foreground="#9A3F2C" />
                <TextBlock Text="Planning space" FontWeight="SemiBold" FontSize="13" />
              </StackPanel>
            </Grid>
          </Button>

          <Border Grid.Row="1" Classes="project-card">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding CurrentProject.Name}" FontWeight="Bold" FontSize="14"
                           MaxWidth="154" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="•••" Foreground="#9B968B" FontSize="11" />
              </Grid>
              <TextBlock Grid.Row="1" Text="{Binding CurrentProject.Code}" Classes="mono muted" FontSize="10" />
            </Grid>
          </Border>

          <StackPanel Grid.Row="2" Spacing="18">
            <StackPanel Spacing="5">
              <TextBlock Text="PLAN" Classes="nav-label" />
              <Button Classes="workspace-nav" Classes.active="{Binding IsOverviewSelected}"
                      Command="{Binding NavigateToOverviewCommand}"
                      automation:AutomationProperties.Name="Plan board">
                <Grid ColumnDefinitions="24,*" ColumnSpacing="8">
                  <TextBlock Text="⌗" FontSize="17" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="Plan" />
                </Grid>
              </Button>
              <Button Classes="workspace-nav" Classes.active="{Binding IsReleasesSelected}"
                      Command="{Binding NavigateToReleasesCommand}">
                <Grid ColumnDefinitions="24,*" ColumnSpacing="8">
                  <TextBlock Text="◫" FontSize="16" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="Releases" />
                </Grid>
              </Button>
            </StackPanel>

            <StackPanel Spacing="5">
              <TextBlock Text="PROJECT" Classes="nav-label" />
              <Button Classes="workspace-nav" Classes.active="{Binding IsIntegrationsSelected}"
                      Command="{Binding NavigateToIntegrationsCommand}">
                <Grid ColumnDefinitions="24,*" ColumnSpacing="8">
                  <TextBlock Text="↓" FontSize="17" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="Import work" />
                </Grid>
              </Button>
              <Button Classes="workspace-nav" Classes.active="{Binding IsSyncSelected}"
                      Command="{Binding NavigateToSyncCommand}">
                <Grid ColumnDefinitions="24,*" ColumnSpacing="8">
                  <TextBlock Text="↗" FontSize="16" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="Share changes" />
                </Grid>
              </Button>
              <Button Classes="workspace-nav" Classes.active="{Binding IsTeamSelected}"
                      Command="{Binding NavigateToTeamCommand}">
                <Grid ColumnDefinitions="24,*" ColumnSpacing="8">
                  <TextBlock Text="♙" FontSize="16" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="People" />
                </Grid>
              </Button>
            </StackPanel>
          </StackPanel>

          <StackPanel Grid.Row="3" Spacing="10">
            <Border Classes="sync-note">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Border Width="8" Height="8" CornerRadius="4" Background="#2C9C79" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="1">
                  <TextBlock Text="PROJECT STATUS" Classes="nav-label" />
                  <TextBlock Text="{Binding SyncStatus}" FontSize="11" FontWeight="SemiBold"
                             MaxWidth="165" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Grid>
            </Border>
            <Button Classes="account-button">
              <Button.Flyout>
                <Flyout Placement="RightEdgeAlignedBottom">
                  <StackPanel Width="250" Spacing="10">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding Identity.DisplayName}" FontWeight="Bold" />
                      <TextBlock Text="{Binding TrustBadge}" Classes="muted" FontSize="11" />
                    </StackPanel>
                    <Border Height="1" Background="#DDD8CC" />
                    <Button Classes="secondary" Content="Project safety"
                            Command="{Binding NavigateToTrustCommand}" />
                    <Button Classes="secondary" Content="Switch project"
                            Command="{Binding ReturnToProjectSetupCommand}" />
                    <Border Height="1" Background="#DDD8CC" />
                    <TextBlock Text="Removes only Blueprints planning and sync data. Source repositories stay untouched."
                               Classes="muted" FontSize="10" TextWrapping="Wrap" />
                    <Button Classes="danger" Content="{Binding DeleteCurrentProjectLabel}"
                            Command="{Binding DeleteCurrentProjectCommand}" />
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
              <Grid ColumnDefinitions="34,*,Auto" ColumnSpacing="9">
                <Border Width="32" Height="32" CornerRadius="16" Background="#302E2A">
                  <TextBlock Text="ID" Foreground="White" FontSize="9" FontWeight="Bold"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                  <TextBlock Text="{Binding Identity.DisplayName}" FontSize="11" FontWeight="SemiBold"
                             MaxWidth="120" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="Workspace options" FontSize="9" Foreground="#8A857B" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="›" VerticalAlignment="Center" Foreground="#8A857B" />
              </Grid>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Column="1" Background="#F4F1EA">
        <views:OverviewView IsVisible="{Binding IsOverviewSelected}" />

        <Grid IsVisible="{Binding IsDetailsWorkspaceSelected}" RowDefinitions="88,*">
          <Border Background="#F8F6F0" BorderBrush="#DDD8CC" BorderThickness="0,0,0,1" Padding="30,17">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
              <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectedWorkspaceSectionTitle}" FontSize="25" FontWeight="Bold" LetterSpacing="-0.4" />
                <TextBlock Text="{Binding SelectedWorkspaceSectionDescription}" Classes="muted" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1" Classes="secondary compact" Content="← Back to plan"
                      Command="{Binding NavigateToOverviewCommand}" VerticalAlignment="Center" />
            </Grid>
          </Border>

          <Grid Grid.Row="1" Margin="24">
            <views:ReleasePlannerView IsVisible="{Binding IsReleasesSelected}" />
            <views:TeamView IsVisible="{Binding IsTeamSelected}" />
            <views:SyncView IsVisible="{Binding IsSyncSelected}" />
            <views:TrustView IsVisible="{Binding IsTrustSelected}" />
            <views:IntegrationsView IsVisible="{Binding IsIntegrationsSelected}" />
          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
