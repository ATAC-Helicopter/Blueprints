<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Blueprints.App.ViewModels"
        xmlns:views="using:Blueprints.App.Views.Components"
        xmlns:automation="using:Avalonia.Automation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1440"
        d:DesignHeight="920"
        x:Class="Blueprints.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Blueprints"
        Icon="/Assets/blueprints.ico"
        Width="1440"
        Height="920"
        MinWidth="1040"
        MinHeight="700"
        Background="#F7F8FA">
  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>

  <Grid>
    <views:SetupView IsVisible="{Binding IsSetupMode}" />

    <Grid RowDefinitions="72,*" IsVisible="{Binding HasActiveSession}">
      <Border Background="#101828" BorderBrush="#26334A" BorderThickness="0,0,0,1" Padding="24,0">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="22">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Border Width="34" Height="34" CornerRadius="9" Background="#6D5EF5">
              <TextBlock Text="B" Foreground="White" FontSize="16" FontWeight="Bold"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Blueprints" Foreground="White" FontSize="17" FontWeight="Bold"
                       VerticalAlignment="Center" />
          </StackPanel>

          <Border Grid.Column="1" Classes="project-context" VerticalAlignment="Center">
            <StackPanel Spacing="1">
              <TextBlock Text="CURRENT PROJECT" Foreground="#8EA0BC" FontSize="9" FontWeight="Bold" LetterSpacing="0.8" />
              <StackPanel Orientation="Horizontal" Spacing="7">
                <TextBlock Text="{Binding CurrentProject.Name}" Foreground="White" FontWeight="SemiBold"
                           MaxWidth="180" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding CurrentProject.Code}" Foreground="#A9B7CD" Classes="mono" FontSize="10"
                           VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
          </Border>

          <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center"
                      VerticalAlignment="Stretch" Spacing="2">
            <Button Classes="app-tab" Classes.active="{Binding IsOverviewSelected}"
                    Content="Overview" Command="{Binding NavigateToOverviewCommand}"
                    automation:AutomationProperties.Name="Overview" />
            <Button Classes="app-tab" Classes.active="{Binding IsReleasesSelected}"
                    Content="Releases" Command="{Binding NavigateToReleasesCommand}" />
            <Button Classes="app-tab" Classes.active="{Binding IsIntegrationsSelected}"
                    Content="Imports" Command="{Binding NavigateToIntegrationsCommand}" />
            <Button Classes="app-tab" Classes.active="{Binding IsSyncSelected}"
                    Content="Sync" Command="{Binding NavigateToSyncCommand}" />
            <Button Classes="app-tab" Classes.active="{Binding IsTeamSelected}"
                    Content="Team" Command="{Binding NavigateToTeamCommand}" />
            <Button Classes="app-tab" Classes.active="{Binding IsTrustSelected}"
                    Content="Validation" Command="{Binding NavigateToTrustCommand}" />
          </StackPanel>

          <Border Grid.Column="3" Classes="header-status" VerticalAlignment="Center">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
              <Border Width="7" Height="7" CornerRadius="4" Background="#32D583" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="0">
                <TextBlock Text="SYNC" Foreground="#8EA0BC" FontSize="8" FontWeight="Bold" />
                <TextBlock Text="{Binding SyncStatus}" Foreground="White" FontSize="10" FontWeight="SemiBold"
                           MaxWidth="150" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Grid>
          </Border>

          <Button Grid.Column="4" Classes="user-menu" VerticalAlignment="Center">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel Width="300" Spacing="12">
                  <StackPanel Spacing="3">
                    <TextBlock Text="{Binding Identity.DisplayName}" FontSize="16" FontWeight="Bold" />
                    <TextBlock Text="{Binding TrustBadge}" Classes="muted" />
                  </StackPanel>
                  <Border Height="1" Background="#E4E7EC" />
                  <Button Classes="quiet" Content="Open project validation"
                          Command="{Binding NavigateToTrustCommand}" />
                  <Button Classes="quiet" Content="Switch project"
                          Command="{Binding ReturnToProjectSetupCommand}" />
                  <Border Height="1" Background="#E4E7EC" />
                  <Button Classes="danger" Content="Delete project…"
                          Command="{Binding BeginDeleteCurrentProjectCommand}" />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
            <Grid ColumnDefinitions="32,Auto" ColumnSpacing="8">
              <Border Width="32" Height="32" CornerRadius="16" Background="#6D5EF5">
                <TextBlock Text="ID" Foreground="White" FontSize="9" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Grid.Column="1" Text="⌄" Foreground="#A9B7CD" VerticalAlignment="Center" />
            </Grid>
          </Button>
        </Grid>
      </Border>

      <Grid Grid.Row="1">
        <views:OverviewView IsVisible="{Binding IsOverviewSelected}" />
        <views:ReleasePlannerView IsVisible="{Binding IsReleasesSelected}" />
        <views:IntegrationsView IsVisible="{Binding IsIntegrationsSelected}" />
        <views:SyncView IsVisible="{Binding IsSyncSelected}" />
        <views:TeamView IsVisible="{Binding IsTeamSelected}" />
        <views:TrustView IsVisible="{Binding IsTrustSelected}" />
      </Grid>
    </Grid>

    <Border Background="#99101828" IsVisible="{Binding IsProjectDeletionDialogOpen}">
      <Border Classes="modal-card" Width="560" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="18">
          <Grid ColumnDefinitions="48,*" ColumnSpacing="14">
            <Border Width="48" Height="48" CornerRadius="12" Background="#FEE4E2">
              <TextBlock Text="!" Foreground="#D92D20" FontSize="22" FontWeight="Bold"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="5">
              <TextBlock Text="{Binding ProjectDeletionDialogTitle}" FontSize="22" FontWeight="Bold" />
              <TextBlock Text="This permanently removes Blueprints planning data from both locations. Linked repositories and source files are left untouched."
                         Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>

          <Border Background="#F8FAFC" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="10" Padding="14">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="100,*" ColumnSpacing="10">
                <TextBlock Text="Project code" Classes="field-label" />
                <TextBlock Grid.Column="1" Text="{Binding ProjectDeletionDialogCode}" Classes="mono" FontWeight="Bold" />
              </Grid>
              <Grid ColumnDefinitions="100,*" ColumnSpacing="10">
                <TextBlock Text="Local data" Classes="field-label" />
                <TextBlock Grid.Column="1" Text="{Binding ProjectDeletionDialogLocalPath}" Classes="mono muted"
                           FontSize="11" TextWrapping="Wrap" />
              </Grid>
              <Grid ColumnDefinitions="100,*" ColumnSpacing="10">
                <TextBlock Text="Shared data" Classes="field-label" />
                <TextBlock Grid.Column="1" Text="{Binding ProjectDeletionDialogSharedPath}" Classes="mono muted"
                           FontSize="11" TextWrapping="Wrap" />
              </Grid>
            </StackPanel>
          </Border>

          <TextBlock Text="This action cannot be undone. Create a backup first if you may need this project again."
                     Foreground="#B42318" FontWeight="SemiBold" TextWrapping="Wrap" />

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Classes="secondary" Content="Cancel" Command="{Binding CancelProjectDeletionCommand}" />
            <Button Classes="danger-solid" Content="Delete project permanently"
                    Command="{Binding ConfirmProjectDeletionCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
