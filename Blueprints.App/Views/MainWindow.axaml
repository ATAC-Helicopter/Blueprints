<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Blueprints.App.ViewModels"
        xmlns:views="using:Blueprints.App.Views.Components"
        xmlns:automation="using:Avalonia.Automation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1440"
        d:DesignHeight="920"
        x:Class="Blueprints.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Blueprints"
        Icon="/Assets/blueprints.ico"
        Width="1440"
        Height="920"
        MinWidth="960"
        MinHeight="680"
        Background="#F6F7FB">
  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>

  <Grid>
    <views:SetupView IsVisible="{Binding IsSetupMode}" />

    <Grid RowDefinitions="64,*" IsVisible="{Binding HasActiveSession}">
      <!-- One quiet project bar replaces the old dashboard sidebar. -->
      <Border Background="#FFFFFF"
              BorderBrush="#E2E4EC"
              BorderThickness="0,0,0,1"
              Padding="16,9">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="16">
          <Button Classes="project-switcher"
                  Command="{Binding NavigateToOverviewCommand}"
                  ToolTip.Tip="Return to the planning board">
            <Grid ColumnDefinitions="38,*" ColumnSpacing="10">
              <Border Width="38" Height="38" CornerRadius="11" Background="#6254D9">
                <TextBlock Text="B" Foreground="White" FontSize="17" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                <TextBlock Text="{Binding CurrentProject.Name}" FontWeight="Bold" FontSize="14"
                           MaxWidth="210" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding CurrentProject.Code}" Classes="mono muted" FontSize="10" />
              </StackPanel>
            </Grid>
          </Button>

          <Border Grid.Column="1" Width="1" Background="#E5E6ED" Margin="0,6" />

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3">
            <Button Classes="top-nav"
                    Classes.active="{Binding IsOverviewSelected}"
                    Content="Board"
                    Command="{Binding NavigateToOverviewCommand}"
                    ToolTip.Tip="Planning board (Ctrl/Command+1)"
                    automation:AutomationProperties.Name="Planning board" />
            <Button Classes="top-nav"
                    Classes.active="{Binding IsIntegrationsSelected}"
                    Content="Sources"
                    Command="{Binding NavigateToIntegrationsCommand}"
                    ToolTip.Tip="GitHub, GitLab, Git and planning files (Ctrl/Command+3)" />
            <Button Classes="top-nav"
                    Classes.active="{Binding IsReleasesSelected}"
                    Content="Releases"
                    Command="{Binding NavigateToReleasesCommand}"
                    ToolTip.Tip="Release notes and versions (Ctrl/Command+2)" />
            <Button Classes="top-nav"
                    Classes.active="{Binding IsTeamSelected}"
                    Content="Team"
                    Command="{Binding NavigateToTeamCommand}"
                    ToolTip.Tip="People and permissions (Ctrl/Command+4)" />
            <Button Classes="top-nav"
                    Classes.active="{Binding IsSyncSelected}"
                    Content="Share"
                    Command="{Binding NavigateToSyncCommand}"
                    ToolTip.Tip="Review and share changes (Ctrl/Command+5)" />
          </StackPanel>

          <Border Grid.Column="3" Classes="health-pill" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Border Width="7" Height="7" CornerRadius="4" Background="#35B5A5" VerticalAlignment="Center" />
              <TextBlock Text="{Binding SyncStatus}" FontSize="11" FontWeight="SemiBold"
                         MaxWidth="150" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Border>

          <Button Grid.Column="4" Classes="avatar" Content="ID"
                  ToolTip.Tip="Project and safety options">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel Width="250" Spacing="10">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Identity.DisplayName}" FontWeight="Bold" />
                    <TextBlock Text="{Binding TrustBadge}" Classes="muted" FontSize="11" />
                  </StackPanel>
                  <Border Height="1" Background="#E2E4EC" />
                  <Button Classes="secondary" Content="Safety &amp; trust"
                          Command="{Binding NavigateToTrustCommand}" />
                  <Button Classes="secondary" Content="Switch project"
                          Command="{Binding ReturnToProjectSetupCommand}" />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
        </Grid>
      </Border>

      <Grid Grid.Row="1" Background="#F6F7FB">
        <views:OverviewView IsVisible="{Binding IsOverviewSelected}" />

        <Grid IsVisible="{Binding IsDetailsWorkspaceSelected}" RowDefinitions="76,*">
          <Border Background="#FFFFFF" BorderBrush="#E2E4EC" BorderThickness="0,0,0,1" Padding="28,14">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectedWorkspaceSectionTitle}" FontSize="23" FontWeight="Bold" />
                <TextBlock Text="{Binding SelectedWorkspaceSectionDescription}" Classes="muted" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1" Classes="secondary compact" Content="Back to board"
                      Command="{Binding NavigateToOverviewCommand}" VerticalAlignment="Center" />
            </Grid>
          </Border>

          <Grid Grid.Row="1" Margin="22">
            <views:ReleasePlannerView IsVisible="{Binding IsReleasesSelected}" />
            <views:TeamView IsVisible="{Binding IsTeamSelected}" />
            <views:SyncView IsVisible="{Binding IsSyncSelected}" />
            <views:TrustView IsVisible="{Binding IsTrustSelected}" />
            <views:IntegrationsView IsVisible="{Binding IsIntegrationsSelected}" />
          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
