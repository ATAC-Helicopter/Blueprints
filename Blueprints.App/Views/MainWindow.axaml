<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Blueprints.App.ViewModels"
        xmlns:views="using:Blueprints.App.Views.Components"
        xmlns:automation="using:Avalonia.Automation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1440"
        d:DesignHeight="920"
        x:Class="Blueprints.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Blueprints"
        Icon="/Assets/blueprints.ico"
        Width="1440"
        Height="920"
        MinWidth="1000"
        MinHeight="680"
        Background="#F6F8FC">
  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>

  <Grid>
    <views:SetupView IsVisible="{Binding IsSetupMode}" />

    <Grid ColumnDefinitions="248,*" IsVisible="{Binding HasActiveSession}">
      <Border Background="#FFFFFF"
              BorderBrush="#DCE3ED"
              BorderThickness="0,0,1,0"
              Padding="16,20,16,16">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="20">
          <Button Classes="project-switcher"
                  Command="{Binding NavigateToOverviewCommand}"
                  ToolTip.Tip="Open project overview">
            <Grid ColumnDefinitions="36,*" ColumnSpacing="10">
              <Border Width="36" Height="36" CornerRadius="9" Background="#2563EB">
                <TextBlock Text="B" Foreground="White" FontSize="17" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                <TextBlock Text="Blueprints" FontWeight="Bold" FontSize="16" />
                <TextBlock Text="Project planning" Foreground="#64748B" FontSize="11" />
              </StackPanel>
            </Grid>
          </Button>

          <Border Grid.Row="1" Classes="project-card">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding CurrentProject.Name}" FontWeight="Bold" FontSize="14"
                           MaxWidth="154" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="ACTIVE" Foreground="#059669" FontSize="9" FontWeight="Bold" />
              </Grid>
              <TextBlock Grid.Row="1" Text="{Binding CurrentProject.Code}" Classes="mono muted" FontSize="10" />
            </Grid>
          </Border>

          <StackPanel Grid.Row="2" Spacing="20">
            <StackPanel Spacing="6">
              <TextBlock Text="WORKSPACE" Classes="nav-label" Margin="12,0,0,2" />
              <Button Classes="workspace-nav" Classes.active="{Binding IsOverviewSelected}"
                      Command="{Binding NavigateToOverviewCommand}"
                      automation:AutomationProperties.Name="Overview">
                <Grid ColumnDefinitions="26,*" ColumnSpacing="8">
                  <TextBlock Text="O" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="Overview" />
                </Grid>
              </Button>
              <Button Classes="workspace-nav" Classes.active="{Binding IsReleasesSelected}"
                      Command="{Binding NavigateToReleasesCommand}">
                <Grid ColumnDefinitions="26,*" ColumnSpacing="8">
                  <TextBlock Text="R" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="Releases" />
                </Grid>
              </Button>
              <Button Classes="workspace-nav" Classes.active="{Binding IsIntegrationsSelected}"
                      Command="{Binding NavigateToIntegrationsCommand}">
                <Grid ColumnDefinitions="26,*" ColumnSpacing="8">
                  <TextBlock Text="I" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="Imports" />
                </Grid>
              </Button>
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Text="COLLABORATION" Classes="nav-label" Margin="12,0,0,2" />
              <Button Classes="workspace-nav" Classes.active="{Binding IsSyncSelected}"
                      Command="{Binding NavigateToSyncCommand}">
                <Grid ColumnDefinitions="26,*" ColumnSpacing="8">
                  <TextBlock Text="S" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="Sync" />
                </Grid>
              </Button>
              <Button Classes="workspace-nav" Classes.active="{Binding IsTeamSelected}"
                      Command="{Binding NavigateToTeamCommand}">
                <Grid ColumnDefinitions="26,*" ColumnSpacing="8">
                  <TextBlock Text="T" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="Team" />
                </Grid>
              </Button>
              <Button Classes="workspace-nav" Classes.active="{Binding IsTrustSelected}"
                      Command="{Binding NavigateToTrustCommand}">
                <Grid ColumnDefinitions="26,*" ColumnSpacing="8">
                  <TextBlock Text="V" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="Validation" />
                </Grid>
              </Button>
            </StackPanel>
          </StackPanel>

          <StackPanel Grid.Row="3" Spacing="10">
            <Border Classes="sync-note">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Border Width="8" Height="8" CornerRadius="4" Background="#059669" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="1">
                  <TextBlock Text="SYNC STATUS" Classes="nav-label" />
                  <TextBlock Text="{Binding SyncStatus}" FontSize="11" FontWeight="SemiBold"
                             MaxWidth="165" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Grid>
            </Border>
            <Button Classes="account-button">
              <Button.Flyout>
                <Flyout Placement="RightEdgeAlignedBottom">
                  <StackPanel Width="250" Spacing="10">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding Identity.DisplayName}" FontWeight="Bold" />
                      <TextBlock Text="{Binding TrustBadge}" Classes="muted" FontSize="11" />
                    </StackPanel>
                    <Border Height="1" Background="#DCE3ED" />
                    <Button Classes="secondary" Content="Project validation"
                            Command="{Binding NavigateToTrustCommand}" />
                    <Button Classes="secondary" Content="Switch project"
                            Command="{Binding ReturnToProjectSetupCommand}" />
                    <Border Height="1" Background="#DCE3ED" />
                    <TextBlock Text="Removes only Blueprints planning and sync data. Source repositories stay untouched."
                               Classes="muted" FontSize="10" TextWrapping="Wrap" />
                    <Button Classes="danger" Content="{Binding DeleteCurrentProjectLabel}"
                            Command="{Binding DeleteCurrentProjectCommand}" />
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
              <Grid ColumnDefinitions="34,*,Auto" ColumnSpacing="9">
                <Border Width="32" Height="32" CornerRadius="16" Background="#E8F0FF">
                  <TextBlock Text="ID" Foreground="#1D4ED8" FontSize="9" FontWeight="Bold"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                  <TextBlock Text="{Binding Identity.DisplayName}" FontSize="11" FontWeight="SemiBold"
                             MaxWidth="120" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="Project settings" FontSize="9" Foreground="#64748B" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="⌄" VerticalAlignment="Center" Foreground="#64748B" />
              </Grid>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Column="1" Background="#F6F8FC">
        <views:OverviewView IsVisible="{Binding IsOverviewSelected}" />

        <Grid IsVisible="{Binding IsDetailsWorkspaceSelected}" RowDefinitions="86,*">
          <Border Background="#FFFFFF" BorderBrush="#DCE3ED" BorderThickness="0,0,0,1" Padding="32,16">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
              <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectedWorkspaceSectionTitle}" FontSize="24" FontWeight="Bold" LetterSpacing="-0.3" />
                <TextBlock Text="{Binding SelectedWorkspaceSectionDescription}" Classes="muted" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1" Classes="secondary compact" Content="Back to overview"
                      Command="{Binding NavigateToOverviewCommand}" VerticalAlignment="Center" />
            </Grid>
          </Border>

          <Grid Grid.Row="1" Margin="24,20">
            <views:ReleasePlannerView IsVisible="{Binding IsReleasesSelected}" />
            <views:TeamView IsVisible="{Binding IsTeamSelected}" />
            <views:SyncView IsVisible="{Binding IsSyncSelected}" />
            <views:TrustView IsVisible="{Binding IsTrustSelected}" />
            <views:IntegrationsView IsVisible="{Binding IsIntegrationsSelected}" />
          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
